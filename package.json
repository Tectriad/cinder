{
  "name": "cinder-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Cinder React Component Library & Showcase Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@cinder-ui/web",
    "dev:lib": "npm run dev --workspace=@cinder-ui/core",
    "build": "npm run build --workspaces",
    "build:lib": "npm run build --workspace=@cinder-ui/core",
    "build:web": "npm run build --workspace=@cinder-ui/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "rm -rf node_modules packages/*/dist packages/*/node_modules apps/*/dist apps/*/node_modules"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
